# Publishable key de Portal (pk_...). Es segura en el bundle del navegador.
NEXT_PUBLIC_PORTAL_API_KEY=pk_...

# Server-side. Nada de esto lleva NEXT_PUBLIC_: ninguna de estas claves puede llegar al
# bundle del navegador.
# Clave de la API de NVIDIA BUILD para el LLM de extracción (ticket 07).
NEXT_NVIDIA_API_KEY=
# Modelo del extractor (el .env.example de la raíz ya lo define).
NVIDIA_LLM_MODEL=meta/llama-3.1-8b-instruct
# Secreto de firma de los webhooks de Portal: lo devuelve GET /v1/webhooks/secret con la secret key.
PORTAL_WEBHOOK_SECRET=whsec_...
# Secret key de Portal (sk_...), para el CLI y para acuñar el secreto del webhook.
PORTAL_SECRET=sk_...
